{
  "family": "api-calendario-task-definition",
  "networkMode": "awsvpc",
  "cpu": "256",   
  "memory": "512", 
  "executionRoleArn": "arn:aws:iam::875218874321:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::875218874321:role/api-calendario-task-role",
  "containerDefinitions": [
    {
      "name": "api-calendario-container", 
      "image": "875218874321.dkr.ecr.us-east-2.amazonaws.com/api-calendario:latest", 
      "portMappings": [
        {
          "containerPort": 8080, 
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/api-calendario", 
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": {
      "operatingSystemFamily": "LINUX"
  }
}